{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmsim.local/schemas/codex-exec-decision/1.0",
  "title": "NMSim Codex exec trading decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reasoning",
    "sentiment",
    "public_take",
    "action",
    "quantity",
    "limit_price"
  ],
  "properties": {
    "reasoning": {
      "type": "string",
      "description": "A short private explanation authored by the model; not hidden chain-of-thought.",
      "maxLength": 240
    },
    "sentiment": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "public_take": {
      "type": "string",
      "maxLength": 140
    },
    "action": {
      "type": "string",
      "enum": ["buy", "sell", "hold"]
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    },
    "limit_price": {
      "anyOf": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"action": {"const": "hold"}},
        "required": ["action"]
      },
      "then": {
        "properties": {"quantity": {"const": 0}}
      }
    }
  ]
}
